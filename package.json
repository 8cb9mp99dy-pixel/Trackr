{
  "name": "trackr",
  "private": true,
  "description": "Dev-only tooling for Trackr. The app itself has no build step and no runtime dependencies: open index.html.",
  "scripts": {
    "check": "node tools/dev/check-syntax.js",
    "lint": "eslint .",
    "test": "node --test tests/unit/",
    "test:e2e": "playwright test",
    "validate:html": "html-validate index.html",
    "serve": "node tools/dev/serve.js 8080",
    "check:sw": "node tools/dev/check-sw-version.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.48.0",
    "eslint": "^9.12.0",
    "html-validate": "^8.24.0"
  }
}
